# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PYTHON_BACKEND_URL: Optional Python/FastAPI/Flask SAR engine backend URL.
# If provided, Express proxies requests to this backend. If absent, the built-in SAR scientific engine is used.
PYTHON_BACKEND_URL=""

# STREAMLIT_URL: Optional Streamlit SpillTwin application URL for interactive embed.
STREAMLIT_URL=""

# SATELLITE_MAP_TILE_URL: Optional custom satellite imagery tile template (defaults to Esri World Imagery if empty).
SATELLITE_MAP_TILE_URL="https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"

# EMAIL NOTIFICATION GATEWAY (Optional - choose Resend API, SendGrid, or SMTP/Gmail)
# Resend API key (https://resend.com)
RESEND_API_KEY=""

# Custom SMTP server (e.g. smtp.gmail.com, smtp.mailgun.org, port 587 or 465)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="alerts@spilltwin.maritime.gov"

# Or standard Gmail App Password
GMAIL_USER=""
GMAIL_APP_PASS=""

# Or SendGrid API Key
SENDGRID_API_KEY=""

# SMS NOTIFICATION GATEWAY (Optional - Twilio for real cellular SMS transmission)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
